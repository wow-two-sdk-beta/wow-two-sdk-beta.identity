# The service's email relay for a local run: the Mailpit container in docker-compose.yml. identity.local.env (optional,
# gitignored) is read after this file and overrides these keys with a real sender; see the compose file's header.
Identity__Email__From=identity@identity.local
Identity__Email__FromName=Identity (local)
Identity__Email__Smtp__Host=mailpit
Identity__Email__Smtp__Port=1025
Identity__Email__Smtp__SecureSocket=None
