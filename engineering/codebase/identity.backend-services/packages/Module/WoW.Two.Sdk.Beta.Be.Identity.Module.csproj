<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Form 1 (layer 3): Identity in the consumer's process, over the consumer's database — AddUserAccounts and its slices
    (passwords, tokens, email, lockout, roles, claims, logins, two-factor, phones, refresh tokens, passkeys,
    organizations, sessions, the sign-in log, email sign-in, personal data, the account endpoints), OTP and its five
    channels, TOTP, WebAuthn and Argon2. The Module owns its PostgreSQL schema: IdentityDbContext maps it, OpenIddict's
    four OIDC tables and the Data Protection key table included (OpenIddict's entity classes come from
    OpenIddict.EntityFrameworkCore.Models, which has no dependencies), and embedded
    Migrations/Postgres/NNN-name/{Apply,Rollback}.sql create it as the be sdk migration set "identity".
  -->
  <PropertyGroup>
    <RootNamespace>WoW.Two.Sdk.Beta.Be.Identity</RootNamespace>
    <Description>Identity Form 1: user accounts and their slices, OTP over email, SMS, Telegram and WhatsApp, TOTP, passkeys and Argon2, in the consumer's process over its own database.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="WoW2.Sdk.Beta.Be" />
    <PackageReference Include="Fido2.AspNet" />
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" />
    <PackageReference Include="OpenIddict.EntityFrameworkCore.Models" />
    <PackageReference Include="Otp.NET" />
    <PackageReference Include="Telegram.Bot" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Auth\WoW.Two.Sdk.Beta.Be.Identity.Auth.csproj" />
  </ItemGroup>

  <!-- SQL migrations ship embedded (logical name "Migrations/Postgres/NNN-name/Apply.sql"); PostgreSQL is the only engine. -->
  <ItemGroup>
    <EmbeddedResource Include="Migrations\**\*.sql">
      <LogicalName>Migrations/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Identity.Tests.Unit" />
    <InternalsVisibleTo Include="Identity.Tests.Integration" />
    <InternalsVisibleTo Include="Identity.Tests.Migrations" />
  </ItemGroup>

</Project>
