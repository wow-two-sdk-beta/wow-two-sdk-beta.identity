# Build output
**/bin/
**/obj/
**/dist/
**/.vite/
node_modules/
*.tsbuildinfo
**/coverage/
**/logs/

# Packed packages (CI packs into the runner temp; a local pack lands here)
*.nupkg
*.snupkg
*.tgz

# Local DB + secrets
*.db
*.db-shm
*.db-wal
# appsettings.Local.json is this machine's own, read by an IDE run only; appsettings.Target.json a target's, mounted
# at deploy; appsettings.Machine.json the machine file's retired name
**/appsettings.Local.json
**/appsettings.Target.json
**/appsettings.Machine.json
.env

# Built SPA copied into the API host (regenerated by `pnpm run deploy` or any non-BuildSpa=false build)
engineering/codebase/identity.backend-services/service/Identity.Api/wwwroot/*
!engineering/codebase/identity.backend-services/service/Identity.Api/wwwroot/.gitkeep

# IDE / OS
.idea/
.vs/
.vscode/*
.DS_Store
