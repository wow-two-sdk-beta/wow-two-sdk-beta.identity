{
  "name": "@identity/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Identity hosted pages and admin console, served by Identity.Api.",
  "scripts": {
    "dev": "vite",
    "dev:http": "vite --mode http",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && pnpm check:sfc",
    "check:sfc": "node scripts/check-sfc.mjs",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "format": "prettier --write src tests scripts *.ts *.mjs *.json index.html",
    "format:check": "prettier --check src tests scripts *.ts *.mjs *.json index.html",
    "lint": "eslint ."
  },
  "dependencies": {
    "@wow-two-beta/fe": "0.0.32",
    "@wow-two-beta/fe-identity": "workspace:*",
    "vue": "^3.5.13",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/compiler-sfc": "^3.5.13",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.14.0",
    "eslint-plugin-vue": "^9.32.0",
    "globals": "^16.0.0",
    "happy-dom": "^20.11.2",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.13.0",
    "vite": "^6.0.0",
    "vite-plugin-mkcert": "^1.17.8",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^2.2.0"
  }
}
