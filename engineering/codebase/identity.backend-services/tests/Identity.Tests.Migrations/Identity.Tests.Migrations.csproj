<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!--
    Migrations tier: the module's embedded Migrations/Postgres/NNN-name/*.sql as the "identity" set — apply,
    apply → rollback → apply, the applied schema against the IdentityDbContext model column for column (index filters
    included), the module's own registration into a configured schema, the be sdk lint above the applied 001–003, the
    published tables and the soft-delete indexes — on PostgreSQL in Testcontainers, one container for the tier. Rides
