{
  "name": "@wow-two-beta/fe-identity",
  "version": "0.0.0",
  "description": "Identity domain UI: the Greetings contract, an embeddable greeting widget and the forward to the hosted page.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wow-two-sdk-beta/wow-two-sdk-beta.identity.git",
    "directory": "engineering/codebase/identity.frontend-services/packages/fe-identity"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "exports": {
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "import": "./dist/contracts/index.js",
      "default": "./dist/contracts/index.js"
    },
    "./kit": {
      "types": "./dist/kit/index.d.ts",
      "import": "./dist/kit/index.js",
      "default": "./dist/kit/index.js"
    }
  },
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write src tests scripts *.ts *.mjs *.json",
    "format:check": "prettier --check src tests scripts *.ts *.mjs *.json",
    "check:package": "node scripts/check-package.mjs"
  },
  "peerDependencies": {
    "@wow-two-beta/fe": ">=0.0.32 <0.1.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "@wow-two-beta/fe": "0.0.32",
    "eslint": "^9.14.0",
    "eslint-plugin-vue": "^9.32.0",
    "globals": "^16.0.0",
    "happy-dom": "^20.11.2",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.13.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.10",
    "vue": "^3.5.13",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^2.2.0"
  }
}
