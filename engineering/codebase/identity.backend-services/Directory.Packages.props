<Project>

  <!--
    Central Package Management — one version per package for the whole solution; project files name packages only.
    The family's own packages arrive by ProjectReference, never by version. core-latest.yml overrides
    BackendSdkVersion with the newest published be sdk (-p:BackendSdkVersion=…) to catch drift nightly.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- The core pin; it is also each package's nuspec floor on WoW2.Sdk.Beta.Be and the kernel. -->
    <BackendSdkVersion>10.0.93-beta</BackendSdkVersion>
  </PropertyGroup>

  <!-- be sdk: one family, bumped together. The kernel (Result, AppError, IEvent) is the only package the contract takes. -->
  <ItemGroup>
    <PackageVersion Include="WoW2.Sdk.Beta.Be.Abstractions" Version="$(BackendSdkVersion)" />
    <PackageVersion Include="WoW2.Sdk.Beta.Be" Version="$(BackendSdkVersion)" />
    <PackageVersion Include="WoW2.Sdk.Beta.Be.Testing" Version="$(BackendSdkVersion)" />
    <PackageVersion Include="WoW2.Sdk.Beta.Be.Testing.Data" Version="$(BackendSdkVersion)" />
  </ItemGroup>

  <!--
    Third-party floors, one row per package, at the versions the be sdk pinned when Identity left it (10.0.81-beta,
    6f55cfe). Each package layer takes only its own: Auth the JWT set, Module the credential set, Client OpenIdConnect,
    Providers the OAuth set, Server OpenIddict. OpenIddict 7.7.2 needs EF Core 10.0.11 or later, which the be sdk pin
    carries from 10.0.86-beta; the Module takes only OpenIddict's dependency-free entity classes, so its context maps the
    OIDC tables without the server.
  -->
  <ItemGroup Label="Auth">
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.3" />
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.14.0" />
    <PackageVersion Include="Microsoft.IdentityModel.Tokens" Version="8.14.0" />
  </ItemGroup>

  <ItemGroup Label="Module">
    <PackageVersion Include="Fido2.AspNet" Version="3.0.1" />
    <PackageVersion Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <PackageVersion Include="OpenIddict.EntityFrameworkCore.Models" Version="7.7.2" />
    <PackageVersion Include="Otp.NET" Version="1.4.0" />
    <PackageVersion Include="Telegram.Bot" Version="22.10.0.1" />
  </ItemGroup>

  <ItemGroup Label="Client">
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup Label="Server">
    <PackageVersion Include="OpenIddict.AspNetCore" Version="7.7.2" />
    <PackageVersion Include="OpenIddict.EntityFrameworkCore" Version="7.7.2" />
  </ItemGroup>

  <ItemGroup Label="Providers">
    <PackageVersion Include="AspNet.Security.OAuth.Amazon" Version="10.0.0" />
    <PackageVersion Include="AspNet.Security.OAuth.Apple" Version="10.0.0" />
    <PackageVersion Include="AspNet.Security.OAuth.Discord" Version="10.0.0" />
    <PackageVersion Include="AspNet.Security.OAuth.GitHub" Version="10.0.0" />
    <PackageVersion Include="AspNet.Security.OAuth.GitLab" Version="10.0.0" />
    <PackageVersion Include="AspNet.Security.OAuth.LinkedIn" Version="10.0.0" />
    <PackageVersion Include="AspNet.Security.OAuth.Notion" Version="10.0.0" />
    <PackageVersion Include="AspNet.Security.OAuth.Reddit" Version="10.0.0" />
    <PackageVersion Include="AspNet.Security.OAuth.Slack" Version="10.0.0" />
    <PackageVersion Include="AspNet.Security.OAuth.Spotify" Version="10.0.0" />
    <PackageVersion Include="AspNet.Security.OAuth.Twitch" Version="10.0.0" />
    <PackageVersion Include="AspNet.Security.OAuth.Twitter" Version="10.0.0" />
    <PackageVersion Include="AspNet.Security.OAuth.Vkontakte" Version="10.0.0" />
    <PackageVersion Include="AspNet.Security.OAuth.Yandex" Version="10.0.0" />
    <PackageVersion Include="Google.Apis.Auth" Version="1.75.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.Facebook" Version="10.0.3" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.Google" Version="10.0.3" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.MicrosoftAccount" Version="10.0.3" />
  </ItemGroup>

  <!-- Tests. -->
  <ItemGroup>
    <PackageVersion Include="AwesomeAssertions" Version="9.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.3" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="9.1.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
