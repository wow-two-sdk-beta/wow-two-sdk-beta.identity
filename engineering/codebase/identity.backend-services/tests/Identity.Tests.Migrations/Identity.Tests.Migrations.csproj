<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!--
    Migrations tier: the module's embedded Migrations/Postgres/NNN-name/*.sql as the "identity" set — apply,
    idempotency, apply → rollback → apply, the applied schema against the IdentityDbContext model column for column, and
    the module's own registration into a configured schema — on PostgreSQL in Testcontainers, one container for the
    tier. Rides the SDK Testing.Data harness (MigratorHarness, MigratorPostgresFixture).
  -->
  <ItemGroup>
    <PackageReference Include="WoW2.Sdk.Beta.Be.Testing.Data" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="AwesomeAssertions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\packages\Module\WoW.Two.Sdk.Beta.Be.Identity.Module.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
