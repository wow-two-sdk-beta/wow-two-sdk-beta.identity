<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!--
    Unit tier — per-package logic with no database, no network and no Docker: Auth (API keys, allowlist, guest, current
    user, JWT), Module's OTP, error texts and personal-data masks, Providers' Google ID-token authenticator, Server's
    keys (settings source with inline PEM bundles, check, selection, generator, command), the Data Protection ring's
    wrapping and boot check, claim mapping and client registration. In-memory TestServer pipelines count as unit
    here; certificates are throwaway, made in memory or in temp files. Tests moved from the be sdk keep their namespaces
    (WoW.Two.Sdk.Beta.Be.Identity.Tests.*).
  -->
  <!-- The shared framework, as the service has it: framework packages OpenIddict asks for (Data Protection) are pruned, not restored. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\packages\Auth\WoW.Two.Sdk.Beta.Be.Identity.Auth.csproj" />
    <ProjectReference Include="..\..\packages\Module\WoW.Two.Sdk.Beta.Be.Identity.Module.csproj" />
    <ProjectReference Include="..\..\packages\Client\WoW.Two.Sdk.Beta.Be.Identity.Client.csproj" />
    <ProjectReference Include="..\..\packages\Providers\WoW.Two.Sdk.Beta.Be.Identity.Providers.csproj" />
    <ProjectReference Include="..\..\packages\Server\WoW.Two.Sdk.Beta.Be.Identity.Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
